-- Daily created vs resolved spine for the classic Jira flow gadget and Genie.
CREATE OR REPLACE VIEW {{METRICS_CATALOG}}.{{METRICS_SCHEMA}}.vw_created_resolved_daily
COMMENT 'Daily created vs resolved counts by project. Source for metric_flow.'
AS
WITH created AS (
  SELECT
    CAST(created_at AS DATE) AS flow_date,
    project_id,
    project_key,
    project_name,
    COUNT(*) AS created_issues,
    SUM(COALESCE(story_points, 0)) AS created_points
  FROM {{GOLD_CATALOG}}.{{GOLD_SCHEMA}}.fct_issue
  GROUP BY ALL
),
resolved AS (
  SELECT
    CAST(resolved_at AS DATE) AS flow_date,
    project_id,
    project_key,
    project_name,
    COUNT(*) AS resolved_issues,
    SUM(COALESCE(story_points, 0)) AS resolved_points
  FROM {{GOLD_CATALOG}}.{{GOLD_SCHEMA}}.fct_issue
  WHERE resolved_at IS NOT NULL
  GROUP BY ALL
)
SELECT
  COALESCE(c.flow_date, r.flow_date) AS flow_date,
  COALESCE(c.project_id, r.project_id) AS project_id,
  COALESCE(c.project_key, r.project_key) AS project_key,
  COALESCE(c.project_name, r.project_name) AS project_name,
  COALESCE(c.created_issues, 0) AS created_issues,
  COALESCE(r.resolved_issues, 0) AS resolved_issues,
  COALESCE(c.created_points, 0) AS created_points,
  COALESCE(r.resolved_points, 0) AS resolved_points,
  COALESCE(c.created_issues, 0) - COALESCE(r.resolved_issues, 0) AS net_backlog_change
FROM created c
FULL OUTER JOIN resolved r
  ON c.flow_date <=> r.flow_date
 AND c.project_id <=> r.project_id;


