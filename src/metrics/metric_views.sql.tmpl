CREATE OR REPLACE VIEW {{METRICS_CATALOG}}.{{METRICS_SCHEMA}}.metric_issue
WITH METRICS
LANGUAGE YAML
COMMENT 'Issue delivery semantics: throughput, cycle/lead time, backlog health.'
AS $$
version: 1.1
source: {{GOLD_CATALOG}}.{{GOLD_SCHEMA}}.fct_issue
filter: issue_id IS NOT NULL
joins:
  - name: project_dim
    source: {{GOLD_CATALOG}}.{{GOLD_SCHEMA}}.dim_project
    on: source.project_id = project_dim.project_id
    cardinality: many_to_one
    rely:
      at_most_one_match: true
  - name: assignee_dim
    source: {{GOLD_CATALOG}}.{{GOLD_SCHEMA}}.dim_user
    on: source.assignee_id = assignee_dim.account_id
    cardinality: many_to_one
    rely:
      at_most_one_match: true
  - name: reporter_dim
    source: {{GOLD_CATALOG}}.{{GOLD_SCHEMA}}.dim_user
    on: source.reporter_id = reporter_dim.account_id
    cardinality: many_to_one
    rely:
      at_most_one_match: true
  - name: status_dim
    source: {{GOLD_CATALOG}}.{{GOLD_SCHEMA}}.dim_status
    on: source.status_id = status_dim.status_id
    cardinality: many_to_one
    rely:
      at_most_one_match: true
  - name: sprint_dim
    source: {{GOLD_CATALOG}}.{{GOLD_SCHEMA}}.dim_sprint
    on: source.current_sprint_id = sprint_dim.sprint_id
    cardinality: many_to_one
    rely:
      at_most_one_match: true
fields:
  - name: Issue Key
    expr: issue_key
    synonyms: ['ticket', 'key']
  - name: Summary
    expr: summary
  - name: Project Key
    expr: project_key
    synonyms: ['project', 'proj']
  - name: Project Name
    expr: project_name
  - name: Project Lead
    expr: project_dim.lead_name
    synonyms: ['project owner', 'lead']
  - name: Project Category
    expr: project_dim.category_name
  - name: Project Type
    expr: project_dim.project_type_key
  - name: Issue Type
    expr: issue_type
    synonyms: ['type']
  - name: Status
    expr: status_name
  - name: Status Category
    expr: status_category
    synonyms: ['category', 'To Do In Progress Done']
  - name: Status Category Order
    expr: status_dim.category_order
  - name: Priority
    expr: priority
  - name: Resolution
    expr: resolution
  - name: Assignee
    expr: assignee_name
    synonyms: ['owner', 'engineer']
  - name: Assignee Email
    expr: assignee_dim.email
  - name: Reporter Email
    expr: reporter_dim.email
  - name: Current Sprint
    expr: current_sprint_name
    synonyms: ['sprint']
  - name: Sprint State
    expr: sprint_dim.state
  - name: Sprint Board
    expr: sprint_dim.board_name
  - name: Age Bucket
    expr: age_bucket
  - name: Age (days)
    expr: age_days
  - name: Cycle Time (days)
    expr: cycle_time_days
  - name: Lead Time (days)
    expr: lead_time_days
  - name: Is Resolved
    expr: is_resolved
  - name: Created Month
    expr: DATE_TRUNC('MONTH', created_at)
  - name: Resolved Month
    expr: DATE_TRUNC('MONTH', resolved_at)
  - name: Created Week
    expr: DATE_TRUNC('WEEK', created_at)
    synonyms: ['week created']
  - name: Resolved Week
    expr: DATE_TRUNC('WEEK', resolved_at)
    synonyms: ['week resolved']
  - name: Created Date
    expr: CAST(created_at AS DATE)
  - name: Resolved Date
    expr: CAST(resolved_at AS DATE)
  - name: Due Date
    expr: CAST(due_date AS DATE)
  - name: Reporter
    expr: reporter_name
    synonyms: ['reporter name']
  - name: Story Points
    expr: story_points
  - name: Priority Group
    expr: CASE WHEN priority IN ('Highest', 'Critical', 'Blocker') THEN 'Critical' WHEN priority = 'High' THEN 'High' WHEN priority IN ('Medium', 'Major') THEN 'Medium' ELSE 'Low / Other' END
    synonyms: ['severity band']
  - name: Is Unassigned
    expr: assignee_id IS NULL
  - name: Is Overdue
    expr: NOT is_resolved AND due_date IS NOT NULL AND CAST(due_date AS DATE) < CURRENT_DATE()
  - name: Is WIP
    expr: NOT is_resolved AND status_category_key = 'indeterminate'
    synonyms: ['in progress flag']
measures:
  - name: Issue Count
    expr: COUNT(1)
    synonyms: ['total issues', 'tickets']
  - name: Open Issues
    expr: COUNT_IF(NOT is_resolved)
    synonyms: ['open', 'backlog']
  - name: Resolved Issues
    expr: COUNT_IF(is_resolved)
    synonyms: ['closed', 'done']
  - name: Open Critical
    expr: COUNT_IF(NOT is_resolved AND priority IN ('Highest', 'Critical', 'Blocker'))
    synonyms: ['critical backlog']
  - name: Stale Open
    expr: COUNT_IF(NOT is_resolved AND age_days > 30)
    synonyms: ['aging issues', 'stale']
  - name: WIP Issues
    expr: COUNT_IF(NOT is_resolved AND status_category_key = 'indeterminate')
    synonyms: ['in progress', 'work in progress', 'wip']
  - name: To Do Issues
    expr: COUNT_IF(NOT is_resolved AND status_category_key = 'new')
    synonyms: ['todo', 'to do']
  - name: Unassigned Open
    expr: COUNT_IF(NOT is_resolved AND assignee_id IS NULL)
    synonyms: ['unassigned', 'no owner']
  - name: Overdue Open
    expr: COUNT_IF(NOT is_resolved AND due_date IS NOT NULL AND CAST(due_date AS DATE) < CURRENT_DATE())
    synonyms: ['overdue', 'past due']
  - name: Created (7d)
    expr: COUNT_IF(created_at >= CURRENT_DATE() - INTERVAL 7 DAYS)
    synonyms: ['created last 7 days', 'new issues this week']
  - name: Created (30d)
    expr: COUNT_IF(created_at >= CURRENT_DATE() - INTERVAL 30 DAYS)
    synonyms: ['created last 30 days', 'inflow']
  - name: Created (90d)
    expr: COUNT_IF(created_at >= CURRENT_DATE() - INTERVAL 90 DAYS)
  - name: Resolved (7d)
    expr: COUNT_IF(is_resolved AND resolved_at >= CURRENT_DATE() - INTERVAL 7 DAYS)
    synonyms: ['resolved last 7 days']
  - name: Resolved (30d)
    expr: COUNT_IF(is_resolved AND resolved_at >= CURRENT_DATE() - INTERVAL 30 DAYS)
    synonyms: ['resolved last 30 days', 'outflow', 'throughput']
  - name: Resolved (90d)
    expr: COUNT_IF(is_resolved AND resolved_at >= CURRENT_DATE() - INTERVAL 90 DAYS)
  - name: Avg Cycle Time (days)
    expr: AVG(cycle_time_days)
  - name: Median Cycle Time (days)
    expr: PERCENTILE_APPROX(cycle_time_days, 0.5)
    synonyms: ['p50 cycle time']
  - name: P90 Cycle Time (days)
    expr: PERCENTILE_APPROX(cycle_time_days, 0.9)
    synonyms: ['p90 cycle time']
  - name: Avg Lead Time (days)
    expr: AVG(lead_time_days)
  - name: Total Story Points
    expr: SUM(story_points)
  - name: Open Story Points
    expr: SUM(CASE WHEN NOT is_resolved THEN story_points ELSE 0 END)
    synonyms: ['backlog points']
  - name: Resolved Story Points
    expr: SUM(CASE WHEN is_resolved THEN story_points ELSE 0 END)
  - name: Avg Age (days)
    expr: AVG(age_days)
$$;


